# MongoDB Atlas connection string for the agentic workflow (agentic/).
# 1. Create a free M0 cluster at https://www.mongodb.com/cloud/atlas
# 2. Database Access -> add a database user (read/write)
# 3. Network Access -> allow your IP (or 0.0.0.0/0 for dev)
# 4. Connect -> Drivers -> copy the connection string and paste it here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Optional: real semantic embeddings (Atlas Vector Search).
# Unset => built-in zero-dependency feature-hash embedder (keyword-ish,
# NOT semantic). Requires: pip install openai
# OPENAI_API_KEY=

# Optional: override the workspace root the agents walk.
# Defaults to the repo root (parent of agentic/).
# FLIPPERZERO_ROOT=C:\Users\bugre\FlipperZero

# Optional: where the local FileStore fallback keeps state when MONGODB_URI
# is unset. Defaults to agentic/_local_state (gitignored).
# FLIPPERZERO_STATE_DIR=agentic/_local_state

# ── LLM configuration (for the Flipper AI toolkit: python -m agentic flipper-ai) ──
# These point at any OpenAI-compatible server (Ornith, Ollama, vLLM, OpenAI, etc.)

# Base URL of the API (default: http://localhost:8000/v1 — Ornith's default)
# LLM_BASE_URL=http://localhost:8000/v1

# API key (default: "not-needed" for local servers like Ornith/Ollama)
# LLM_API_KEY=not-needed

# Model name to request (default: "ornith" — matches Ornith's served-model-name)
# LLM_MODEL=ornith
